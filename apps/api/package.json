{
  "name": "@upk/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/apps/api/src/index.js",
    "db:migrate": "node scripts/db-migrate.mjs",
    "build:vercel": "npm run build && node scripts/vercel-build.mjs",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@socket.io/postgres-adapter": "^0.5.0",
    "@vercel/functions": "^3.9.9",
    "jose": "^6.2.9",
    "pg": "^8.23.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
