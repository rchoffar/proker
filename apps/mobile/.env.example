# URL du relais Bluff (apps/api). Inliné au bundle par Expo (préfixe EXPO_PUBLIC_).
# Prod (Fly.io, scale-to-zero) : https://upk-api.fly.dev
# Relais local : http://localhost:3001 (simulateur) ou http://<ip-lan-de-la-machine>:3001 (appareil)
EXPO_PUBLIC_BLUFF_SERVER_URL=https://upk-api.fly.dev

# URL de l'API auth (même serveur Fly que le relais). Laisser vide pour retomber
# sur EXPO_PUBLIC_BLUFF_SERVER_URL. Dev local : http://<ip-lan>:3001
EXPO_PUBLIC_API_URL=

# Client ID iOS Google (Google Cloud Console → identifiants OAuth, type iOS,
# bundle fr.upk.app). Le reversed client ID correspondant va dans app.json
# (plugin @react-native-google-signin, champ iosUrlScheme).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
